{
  "name": "1. New Lead → Welcome Email",
  "flow": [
    {
      "id": 1,
      "module": "google-sheets:watchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": {
          "label": "Google Sheets (kết nối tài khoản của bạn)",
          "data": {}
        },
        "spreadsheetId": "THAY_BANG_SPREADSHEET_ID_CUA_BAN",
        "sheetId": "Contacts",
        "limit": 10,
        "includeRowNumberInResponse": true
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "spreadsheetId": { "label": "Email Marketing Contacts" },
            "sheetId": { "label": "Contacts" }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false },
      "mapper": {
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "headers": [
          { "name": "Authorization", "value": "Bearer THAY_BANG_RESEND_API_KEY" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "{\n  \"from\": \"Phong Menly <hello@DOMAIN_CUA_BAN.com>\",\n  \"to\": [\"{{1.`Cot A - Email`}}\"],\n  \"subject\": \"Chào mừng bạn đến với KOL AI System!\",\n  \"html\": \"<p>Xin chào {{1.`Cot B - Ten`}},</p><p>Cảm ơn bạn đã tham gia cộng đồng KOL AI System của mình!</p><p>Đây là quà tặng mình đã hứa: <a href='https://quatangkolai.lovable.app'>Nhận quà ngay</a></p><p>Trong 7 ngày tới, mình sẽ chia sẻ với bạn từng bước để bắt đầu kiếm tiền với AI.</p><p>Phong Menly</p><p style='font-size:12px;color:#999;'><a href='https://DOMAIN_CUA_BAN.com/unsubscribe?email={{1.`Cot A - Email`}}'>Hủy đăng ký</a></p>\"\n}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": {
          "label": "Google Sheets (kết nối tài khoản của bạn)",
          "data": {}
        },
        "spreadsheetId": "THAY_BANG_SPREADSHEET_ID_CUA_BAN",
        "sheetId": "Contacts"
      },
      "mapper": {
        "rowNumber": "{{1.__ROW_NUMBER__}}",
        "values": {
          "Cot E - Trang thai": "active",
          "Cot F - Buoc sequence": "1",
          "Cot G - Ngay gui cuoi": "{{formatDate(now; \"YYYY-MM-DD\")}}"
        }
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu2.make.com"
  }
}
