                "spreadsheetId": "THAY_BANG_SPREADSHEET_ID_CUA_BAN",
                "sheetId": "Contacts"
              },
              "mapper": {
                "rowNumber": "{{2.__ROW_NUMBER__}}",
                "values": {
                  "Cot F - Buoc sequence": "4",
                  "Cot E - Trang thai": "completed",
