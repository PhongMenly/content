{
  "name": "4. Unsubscribe Handler",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "WEBHOOK_ID_TU_DONG_TAO_SAU_KHI_IMPORT",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": { "label": "Unsubscribe Webhook" }
          }
        }
      }
    },
    {
      "id": 2,
      "module": "google-sheets:searchRows",
      "version": 2,
      "parameters": {
        "__IMTCONN__": {
          "label": "Google Sheets (kết nối tài khoản của bạn)",
          "data": {}
        },
        "spreadsheetId": "THAY_BANG_SPREADSHEET_ID_CUA_BAN",
        "sheetId": "Contacts",
        "filter": {
          "conditions": [
            [{ "a": "{{item.`Cot A - Email`}}", "b": "{{1.email}}", "o": "text:equal" }]
          ]
        },
        "limit": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 300, "y": 0 }
      }
    },
    {
      "id": 3,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": {
          "label": "Google Sheets (kết nối tài khoản của bạn)",
          "data": {}
        },
        "spreadsheetId": "THAY_BANG_SPREADSHEET_ID_CUA_BAN",
        "sheetId": "Contacts"
      },
      "mapper": {
        "rowNumber": "{{2.__ROW_NUMBER__}}",
        "values": {
          "Cot E - Trang thai": "unsubscribed"
        }
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 }
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": false },
      "mapper": {
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "headers": [
          { "name": "Authorization", "value": "Bearer THAY_BANG_RESEND_API_KEY" },
          { "name": "Content-Type", "value": "application/json" }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "{\n  \"from\": \"Phong Menly <hello@DOMAIN_CUA_BAN.com>\",\n  \"to\": [\"{{1.email}}\"],\n  \"subject\": \"Bạn đã hủy đăng ký thành công\",\n  \"html\": \"<p>Xin chào,</p><p>Bạn đã được xóa khỏi danh sách email của mình. Mình rất tiếc khi thấy bạn ra đi.</p><p>Nếu đây là nhầm lẫn, bạn có thể đăng ký lại tại: <a href='https://kolaisystem2026.lovable.app'>đây</a></p><p>Phong Menly</p>\"\n}"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu2.make.com"
  }
}
