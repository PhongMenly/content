<%- include('partials/header', { pageTitle: 'Chi tiết bài viết', active: 'posts' }) %>

<a href="/" class="back-link">&larr; Quay lại danh sách</a>

<div class="post-detail" data-post-id="<%= postId %>">
  <div class="post-detail-header">
    <h1 id="post-title">Đang tải...</h1>
    <span id="post-status" class="status-badge"></span>
  </div>

  <div id="post-stepper"></div>

  <div id="post-metrics-box" class="metrics-box" style="display:none">
    <div class="metrics-row">
      <span class="metric" title="Facebook đã ngừng cung cấp số liệu này qua API cho bài viết"><strong id="metric-reach">0</strong> Tiếp cận</span>
      <span class="metric"><strong id="metric-likes">0</strong> Thích</span>
      <span class="metric"><strong id="metric-comments">0</strong> Bình luận</span>
      <span class="metric"><strong id="metric-shares">0</strong> Chia sẻ</span>
      <span id="metric-posted-date" class="metric-date"></span>
    </div>
    <button id="sync-metrics-btn" class="btn">Làm mới số liệu từ Facebook</button>
    <span id="metric-updated-note" class="metric-updated-note"></span>
  </div>

  <div class="post-meta-grid">
    <label>Nền tảng <input type="text" id="meta-platform" /></label>
    <label>Pillar <input type="text" id="meta-pillar" /></label>
    <label>CTA <input type="text" id="meta-cta_type" /></label>
  </div>

  <label class="block-label">Nội dung
    <textarea id="post-body" rows="16"></textarea>
  </label>

  <div class="image-box">
    <div id="post-image-preview"></div>
    <div class="image-actions">
      <button id="open-library-btn" class="btn">Chọn ảnh từ kho</button>
      <label class="btn file-btn">Tải ảnh từ máy
        <input type="file" id="image-input" accept="image/*" hidden />
      </label>
    </div>
  </div>

  <div class="action-bar">
    <button id="save-btn" class="btn">Lưu chỉnh sửa</button>
    <button id="approve-btn" class="btn btn-primary">Duyệt bài (tự động lên lịch)</button>
    <button id="cancel-schedule-btn" class="btn btn-danger" style="display:none">Hủy lịch</button>
    <button id="delete-post-btn" class="btn btn-danger">Xóa bài</button>
  </div>

  <div id="schedule-info" class="schedule-info"></div>

  <div class="schedule-box">
    <label>Đổi lịch đăng — bấm vào ô để chọn ngày giờ
      <input type="datetime-local" id="schedule-input" step="300" />
    </label>
    <button id="schedule-btn" class="btn">Đổi lịch</button>
  </div>

  <dialog id="library-dialog">
    <h2>Chọn ảnh từ kho</h2>
    <div id="library-grid" class="library-grid"></div>
    <div class="dialog-actions">
      <button type="button" id="close-library-btn" class="btn">Đóng</button>
    </div>
  </dialog>

  <h3>Lịch sử</h3>
  <ul id="post-history" class="history-list"></ul>
</div>

<%- include('partials/footer') %>
