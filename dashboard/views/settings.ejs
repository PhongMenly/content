<%- include('partials/header', { pageTitle: 'Cài đặt', active: 'settings' }) %>

<div class="toolbar">
  <h2>Thương hiệu của tôi — AI học từ kênh của bạn</h2>
</div>

<div class="settings-card">
  <label class="block-label">Link kênh YouTube của bạn
    <input type="text" id="brand-channel-input" placeholder="https://www.youtube.com/@Phongmenlyaigoglobalus" />
  </label>
  <div class="settings-row">
    <button id="brand-analyze-btn" class="btn btn-primary">Phân tích và cập nhật hồ sơ thương hiệu</button>
    <span id="brand-note" class="fb-subtext"></span>
  </div>
  <label class="block-label">Hồ sơ thương hiệu (AI dùng hồ sơ này mỗi lần đề xuất chủ đề và viết bài — bạn sửa tay được)
    <textarea id="brand-profile-text" rows="10"></textarea>
  </label>
  <div class="settings-row">
    <button id="brand-save-btn" class="btn">Lưu hồ sơ</button>
    <span id="brand-save-note" class="fb-subtext"></span>
  </div>
</div>

<div class="toolbar" style="margin-top:24px">
  <h2>Chia sẻ lên nhóm Facebook</h2>
</div>

<div class="settings-card">
  <div id="fb-login-status" class="schedule-info"></div>
  <label class="block-label">Danh sách nhóm (mỗi dòng 1 link, dạng https://www.facebook.com/groups/...)
    <textarea id="groups-input" rows="8" placeholder="https://www.facebook.com/groups/nhom-cua-ban"></textarea>
  </label>
  <div class="settings-row">
    <label class="block-label" style="max-width:220px">Số nhóm tối đa mỗi lần chia sẻ
      <input type="number" id="max-per-run" min="1" max="10" value="5" />
    </label>
    <label class="block-label" style="max-width:260px">Chờ bao nhiêu phút sau khi đăng Page
      <input type="number" id="share-delay" min="5" max="120" value="20" />
    </label>
    <label class="settings-checkbox">
      <input type="checkbox" id="auto-share-toggle" />
      Tự động chia sẻ vào nhóm sau khi bài đăng Page thành công
    </label>
  </div>
  <div class="settings-row">
    <button id="save-groups-btn" class="btn btn-primary">Lưu cài đặt</button>
    <span id="save-result" class="fb-subtext"></span>
  </div>
</div>

<div class="toolbar" style="margin-top:24px">
  <h2>Kết quả chia sẻ nhóm gần nhất</h2>
</div>
<div class="settings-card">
  <ul id="share-log" class="history-list"><li>Chưa có dữ liệu</li></ul>
</div>

<div class="toolbar" style="margin-top:24px">
  <h2>Nhật ký hệ thống tự đăng (cron)</h2>
</div>
<div class="settings-card">
  <pre id="cron-log" class="cron-log">Đang tải...</pre>
</div>

<script>
  async function loadSettings() {
    const res = await fetch('/api/settings/groups');
    const data = await res.json();
    document.getElementById('groups-input').value = (data.groups || []).join('\n');
    document.getElementById('max-per-run').value = data.maxPerRun || 5;
    document.getElementById('share-delay').value = data.shareDelayMinutes || 20;
    document.getElementById('auto-share-toggle').checked = data.autoShareAfterPost === true;
    const statusEl = document.getElementById('fb-login-status');
    statusEl.textContent = data.fbLoggedIn
      ? 'Đã đăng nhập Facebook cho bot chia sẻ.'
      : 'CHƯA đăng nhập Facebook. Mở PowerShell chạy: cd d:\\Content-Creation-Template\\facebook-bot rồi node share-groups.js --setup';
    if (!data.fbLoggedIn) statusEl.style.background = '#FDF3D7', statusEl.style.color = '#92600A';
  }

  async function loadLogs() {
    const res = await fetch('/api/settings/share-log');
    const data = await res.json();
    if (data.lastResult && data.lastResult.length) {
      document.getElementById('share-log').innerHTML = data.lastResult
        .map(r => `<li>${r.ok ? 'OK' : 'LỖI'} — ${r.url}${r.error ? ' — ' + r.error : ''}</li>`)
        .join('');
    }
    if (data.cronTail && data.cronTail.length) {
      document.getElementById('cron-log').textContent = data.cronTail.join('\n');
    }
  }

  document.getElementById('save-groups-btn').addEventListener('click', async () => {
    const groups = document.getElementById('groups-input').value.split('\n').map(s => s.trim()).filter(Boolean);
    const maxPerRun = document.getElementById('max-per-run').value;
    const shareDelayMinutes = document.getElementById('share-delay').value;
    const autoShareAfterPost = document.getElementById('auto-share-toggle').checked;
    const res = await fetch('/api/settings/groups', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ groups, maxPerRun, shareDelayMinutes, autoShareAfterPost }),
    });
    const data = await res.json();
    document.getElementById('save-result').textContent = res.ok
      ? `Đã lưu ${data.saved} nhóm hợp lệ.`
      : 'Lỗi lưu cài đặt';
    loadSettings();
  });

  loadSettings();
  loadLogs();

  // ===== Ho so thuong hieu =====
  async function loadBrandProfile() {
    const res = await fetch('/api/settings/brand-profile');
    const data = await res.json();
    document.getElementById('brand-profile-text').value = data.text || '';
    if (data.sourceUrl) document.getElementById('brand-channel-input').value = data.sourceUrl;
    if (data.isDefault) document.getElementById('brand-note').textContent = 'Đang dùng hồ sơ mặc định — dán link kênh và bấm phân tích để AI tự học từ kênh của bạn.';
  }

  document.getElementById('brand-analyze-btn').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const url = document.getElementById('brand-channel-input').value.trim();
    const note = document.getElementById('brand-note');
    if (!url) { note.textContent = 'Dán link kênh trước đã.'; return; }
    btn.disabled = true;
    btn.textContent = 'AI đang phân tích kênh...';
    note.textContent = 'Thường mất 20-40 giây.';
    try {
      const res = await fetch('/api/settings/brand-profile/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const data = await res.json();
      if (res.ok) {
        note.textContent = `Đã học từ ${data.videoCount} video của kênh "${data.channelTitle}". Xem và sửa hồ sơ bên dưới nếu cần.`;
        document.getElementById('brand-profile-text').value = data.profile;
      } else {
        note.textContent = 'Lỗi: ' + (data.error || res.status);
      }
    } catch (err) {
      note.textContent = 'Lỗi kết nối: ' + err.message;
    }
    btn.disabled = false;
    btn.textContent = 'Phân tích và cập nhật hồ sơ thương hiệu';
  });

  document.getElementById('brand-save-btn').addEventListener('click', async () => {
    const text = document.getElementById('brand-profile-text').value;
    const res = await fetch('/api/settings/brand-profile', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text }),
    });
    document.getElementById('brand-save-note').textContent = res.ok ? 'Đã lưu hồ sơ.' : 'Lỗi lưu hồ sơ';
  });

  loadBrandProfile();
</script>

<%- include('partials/footer') %>
