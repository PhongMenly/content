<%- include('partials/header', { pageTitle: 'Cài đặt', active: 'settings' }) %>

<div class="toolbar">
  <h2>Hồ sơ thương hiệu — AI học từ kênh của bạn</h2>
</div>

<div class="settings-card">
  <label class="block-label">Đang chỉnh hồ sơ cho
    <div class="settings-row">
      <select id="brand-profile-select" style="flex:1"></select>
      <button id="brand-add-profile-btn" class="btn">+ Thêm hồ sơ mới</button>
      <button id="brand-delete-profile-btn" class="btn btn-danger">Xóa hồ sơ này</button>
    </div>
  </label>
  <div class="fb-subtext">Mỗi Page/persona (Phong Menly, Uyên Linh...) nên có 1 hồ sơ riêng để AI viết đúng văn phong của từng kênh.</div>

  <hr style="border:none;border-top:1px solid var(--line, #DFE2E7);margin:16px 0" />

  <label class="block-label">Dán 1 link bất kỳ (kênh YouTube, trang web, blog...)
    <input type="text" id="brand-channel-input" placeholder="https://www.youtube.com/@Phongmenlyaigoglobalus hoặc bất kỳ link nào" />
  </label>
  <div class="settings-row">
    <button id="brand-analyze-btn" class="btn btn-primary">Phân tích và cập nhật hồ sơ thương hiệu</button>
    <span id="brand-note" class="fb-subtext"></span>
  </div>
  <div id="brand-progress-wrap" class="progress-bar-wrap"><div class="progress-bar-fill"></div></div>
  <div class="fb-subtext">Link YouTube sẽ đọc chính xác theo lượt xem từng video. Link khác (web, blog...) AI đọc nội dung trang — trang cần đăng nhập hoặc load bằng JavaScript (Facebook cá nhân, TikTok...) có thể đọc được rất ít.</div>

  <div class="settings-row" style="margin-top:8px">
    <button id="brand-analyze-fb-btn" class="btn">Phân tích từ Facebook Page của tôi</button>
    <span id="brand-fb-note" class="fb-subtext"></span>
  </div>
  <div id="brand-fb-progress-wrap" class="progress-bar-wrap"><div class="progress-bar-fill"></div></div>
  <div class="fb-subtext">Dùng luôn trang Facebook đang kết nối để đăng bài (không cần dán link) — AI đọc các bài cũ, xếp theo tương tác để rút hồ sơ thương hiệu.</div>

  <hr style="border:none;border-top:1px solid var(--line, #DFE2E7);margin:16px 0" />

  <label class="block-label">Hoặc dán trực tiếp nội dung bất kỳ (copy vài bài từ Facebook cá nhân, tin nhắn, ghi chú...) — luôn đọc được 100%, không phụ thuộc link. Nên dán từ 3-5 bài trở lên (tối thiểu ~400 ký tự) để AI rút hồ sơ chính xác, tránh đoán mò.
    <textarea id="brand-paste-text" rows="6" placeholder="Copy vài bài viết/đoạn văn tiêu biểu (càng nhiều bài càng chính xác) rồi dán vào đây..."></textarea>
  </label>
  <div class="settings-row">
    <button id="brand-analyze-text-btn" class="btn">Phân tích nội dung đã dán</button>
    <span id="brand-text-note" class="fb-subtext"></span>
  </div>
  <div id="brand-text-progress-wrap" class="progress-bar-wrap"><div class="progress-bar-fill"></div></div>

  <label class="block-label">Hồ sơ thương hiệu (AI dùng hồ sơ này mỗi lần đề xuất chủ đề và viết bài — bạn sửa tay được)
    <textarea id="brand-profile-text" rows="10"></textarea>
  </label>
  <div class="settings-row">
    <button id="brand-save-btn" class="btn">Lưu hồ sơ</button>
    <span id="brand-save-note" class="fb-subtext"></span>
  </div>
</div>

<script>
  // ===== Ho so thuong hieu (nhieu persona) =====
  let currentProfileKey = 'phong_menly';

  async function loadProfileList() {
    const res = await fetch('/api/settings/brand-profiles');
    const profiles = await res.json();
    const select = document.getElementById('brand-profile-select');
    select.innerHTML = profiles.map((p) => `<option value="${p.key}">${p.name}</option>`).join('');
    if (profiles.some((p) => p.key === currentProfileKey)) {
      select.value = currentProfileKey;
    } else if (profiles.length > 0) {
      currentProfileKey = profiles[0].key;
      select.value = currentProfileKey;
    }
    document.getElementById('brand-delete-profile-btn').style.display = currentProfileKey === 'phong_menly' ? 'none' : 'inline-block';
  }

  document.getElementById('brand-profile-select').addEventListener('change', async (e) => {
    currentProfileKey = e.target.value;
    document.getElementById('brand-delete-profile-btn').style.display = currentProfileKey === 'phong_menly' ? 'none' : 'inline-block';
    await loadBrandProfile();
  });

  document.getElementById('brand-add-profile-btn').addEventListener('click', async () => {
    const name = prompt('Tên hồ sơ mới (vd: Uyên Linh):');
    if (!name || !name.trim()) return;
    const key = name.trim().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/g, 'd').replace(/[^a-z0-9]+/g, '_').replace(/(^_|_$)/g, '');
    const res = await fetch('/api/settings/brand-profiles', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key, name: name.trim() }),
    });
    const data = await res.json();
    if (!res.ok) { showToast('Lỗi tạo hồ sơ: ' + (data.error || res.status), 'error'); return; }
    currentProfileKey = key;
    await loadProfileList();
    await loadBrandProfile();
    showToast(`Đã tạo hồ sơ "${name.trim()}".`, 'success');
  });

  document.getElementById('brand-delete-profile-btn').addEventListener('click', async () => {
    if (!confirm(`Xóa hồ sơ này? Không thể hoàn tác.`)) return;
    const res = await fetch(`/api/settings/brand-profiles/${currentProfileKey}`, { method: 'DELETE' });
    if (!res.ok) { showToast('Lỗi xóa hồ sơ', 'error'); return; }
    currentProfileKey = 'phong_menly';
    await loadProfileList();
    await loadBrandProfile();
    showToast('Đã xóa hồ sơ.', 'success');
  });

  async function loadBrandProfile() {
    const res = await fetch(`/api/settings/brand-profile?key=${encodeURIComponent(currentProfileKey)}`);
    const data = await res.json();
    document.getElementById('brand-profile-text').value = data.text || '';
    document.getElementById('brand-channel-input').value = data.source_url || '';
    document.getElementById('brand-note').textContent = data.isDefault ? 'Đang dùng hồ sơ mặc định — dán link kênh và bấm phân tích để AI tự học từ kênh của bạn.' : '';
  }

  document.getElementById('brand-analyze-btn').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const url = document.getElementById('brand-channel-input').value.trim();
    const note = document.getElementById('brand-note');
    const progressWrap = document.getElementById('brand-progress-wrap');
    if (!url) { note.textContent = 'Dán link kênh trước đã.'; return; }
    btn.disabled = true;
    btn.textContent = 'AI đang phân tích kênh...';
    note.textContent = 'Thường mất 20-40 giây.';
    const progressTimer = startProgressBar(progressWrap);
    try {
      const res = await fetch('/api/settings/brand-profile/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url, key: currentProfileKey }),
      });
      const data = await res.json();
      if (res.ok) {
        const unitLabel = data.sourceType === 'video' ? `${data.videoCount} video của kênh` : 'nội dung của';
        note.textContent = `Đã học từ ${unitLabel} "${data.channelTitle}".`;
        document.getElementById('brand-profile-text').value = data.profile;
        showToast(`Phân tích xong! Đã cập nhật hồ sơ thương hiệu từ "${data.channelTitle}".`, 'success');
      } else {
        note.textContent = 'Lỗi: ' + (data.error || res.status);
        showToast('Phân tích lỗi: ' + (data.error || res.status), 'error');
      }
    } catch (err) {
      note.textContent = 'Lỗi kết nối: ' + err.message;
      showToast('Lỗi kết nối: ' + err.message, 'error');
    }
    finishProgressBar(progressWrap, progressTimer);
    btn.disabled = false;
    btn.textContent = 'Phân tích và cập nhật hồ sơ thương hiệu';
  });

  document.getElementById('brand-analyze-fb-btn').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const note = document.getElementById('brand-fb-note');
    const progressWrap = document.getElementById('brand-fb-progress-wrap');
    btn.disabled = true;
    btn.textContent = 'AI đang đọc bài trên Facebook Page...';
    note.textContent = 'Thường mất 20-40 giây.';
    const progressTimer = startProgressBar(progressWrap);
    try {
      const res = await fetch('/api/settings/brand-profile/analyze-facebook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key: currentProfileKey }),
      });
      const data = await res.json();
      if (res.ok) {
        note.textContent = `Đã học từ ${data.postCount} bài trên Facebook Page.`;
        document.getElementById('brand-profile-text').value = data.profile;
        showToast(`Phân tích xong! Đã cập nhật hồ sơ thương hiệu từ ${data.postCount} bài Facebook.`, 'success');
      } else {
        note.textContent = 'Lỗi: ' + (data.error || res.status);
        showToast('Phân tích lỗi: ' + (data.error || res.status), 'error');
      }
    } catch (err) {
      note.textContent = 'Lỗi kết nối: ' + err.message;
      showToast('Lỗi kết nối: ' + err.message, 'error');
    }
    finishProgressBar(progressWrap, progressTimer);
    btn.disabled = false;
    btn.textContent = 'Phân tích từ Facebook Page của tôi';
  });

  document.getElementById('brand-analyze-text-btn').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const note = document.getElementById('brand-text-note');
    const progressWrap = document.getElementById('brand-text-progress-wrap');
    const pasted = document.getElementById('brand-paste-text').value.trim();
    if (!pasted) { note.textContent = 'Dán nội dung trước đã.'; return; }
    btn.disabled = true;
    btn.textContent = 'AI đang đọc nội dung...';
    note.textContent = 'Thường mất 20-40 giây.';
    const progressTimer = startProgressBar(progressWrap);
    try {
      const res = await fetch('/api/settings/brand-profile/analyze-text', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: pasted, key: currentProfileKey }),
      });
      const data = await res.json();
      if (res.ok) {
        note.textContent = 'Đã cập nhật hồ sơ từ nội dung đã dán.';
        document.getElementById('brand-profile-text').value = data.profile;
        showToast('Phân tích xong! Đã cập nhật hồ sơ thương hiệu từ nội dung bạn dán.', 'success');
      } else {
        note.textContent = 'Lỗi: ' + (data.error || res.status);
        showToast('Phân tích lỗi: ' + (data.error || res.status), 'error');
      }
    } catch (err) {
      note.textContent = 'Lỗi kết nối: ' + err.message;
      showToast('Lỗi kết nối: ' + err.message, 'error');
    }
    finishProgressBar(progressWrap, progressTimer);
    btn.disabled = false;
    btn.textContent = 'Phân tích nội dung đã dán';
  });

  document.getElementById('brand-save-btn').addEventListener('click', async () => {
    const text = document.getElementById('brand-profile-text').value;
    const res = await fetch('/api/settings/brand-profile', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text, key: currentProfileKey }),
    });
    document.getElementById('brand-save-note').textContent = res.ok ? 'Đã lưu hồ sơ.' : 'Lỗi lưu hồ sơ';
  });

  (async () => {
    await loadProfileList();
    await loadBrandProfile();
  })();
</script>

<%- include('partials/footer') %>
