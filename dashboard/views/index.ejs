<%- include('partials/header', { pageTitle: 'Bài viết', active: 'posts' }) %>

<div class="toolbar">
  <h2>Quản lý bài viết theo trạng thái</h2>
  <button id="new-post-btn" class="btn btn-primary">+ Tạo bài mới</button>
</div>

<div class="filter-bar">
  <button class="filter-btn active" data-status="">Tất cả</button>
  <button class="filter-btn" data-status="idea">Ý tưởng</button>
  <button class="filter-btn" data-status="draft">Bản nháp</button>
  <button class="filter-btn" data-status="ready_for_review">Chờ duyệt</button>
  <button class="filter-btn" data-status="scheduled">Đã lên lịch</button>
  <button class="filter-btn" data-status="posted">Đã đăng</button>
</div>

<div id="idea-toolbox" class="settings-card" style="display:none">
  <label class="block-label">Từ khóa định hướng cho AI (cách nhau bằng dấu phẩy hoặc xuống dòng)
    <textarea id="idea-keywords" rows="2" placeholder="Ví dụ: Claude Code, kiếm tiền affiliate tool AI, video Seedance 2..."></textarea>
  </label>
  <div class="settings-row">
    <button id="save-keywords-btn" class="btn">Lưu từ khóa</button>
    <button id="generate-ideas-btn" class="btn btn-primary">Đề xuất chủ đề ngay</button>
    <span id="idea-toolbox-note" class="fb-subtext"></span>
  </div>
  <div class="fb-subtext">Có từ khóa: AI bám theo từ khóa và sản phẩm của bạn (chế độ theo yêu cầu). Để trống: AI tự chủ động đề xuất theo 5 pillar. AI cũng tự chạy sáng thứ 2 hàng tuần và gửi danh sách qua Telegram.</div>

  <hr style="border:none;border-top:1px solid #DFE2E7;margin:4px 0" />

  <label class="block-label">Kênh YouTube mẫu để AI học theo (dán link kênh)
    <input type="text" id="ref-channel-input" placeholder="https://www.youtube.com/@tenkenh" />
  </label>
  <div class="settings-row">
    <button id="analyze-channel-btn" class="btn">Phân tích kênh</button>
    <span id="ref-channel-note" class="fb-subtext"></span>
  </div>
  <div id="ref-channel-result" class="fb-subtext"></div>
  <div class="fb-subtext">AI sẽ đọc các video của kênh, xếp hạng theo lượt xem để biết chủ đề nào ăn khách, rồi đề xuất phiên bản nâng cấp mang thương hiệu Phong Menly khi bấm "Đề xuất chủ đề ngay".</div>
</div>

<div id="post-list" class="post-list">
  <!-- Populated by app.js -->
</div>

<dialog id="new-post-dialog">
  <form id="new-post-form">
    <h2>Tạo bài viết mới</h2>
    <label>Tiêu đề<input type="text" name="title" required /></label>
    <label>Nền tảng
      <select name="platform">
        <option value="Facebook">Facebook</option>
        <option value="Instagram">Instagram</option>
        <option value="LinkedIn">LinkedIn</option>
        <option value="X">X</option>
        <option value="TikTok">TikTok</option>
      </select>
    </label>
    <label>Pillar<input type="text" name="pillar" placeholder="VD: AI Thực chiến" /></label>
    <label>Nội dung<textarea name="body" rows="10"></textarea></label>
    <div class="dialog-actions">
      <button type="button" id="cancel-new-post" class="btn">Hủy</button>
      <button type="submit" class="btn btn-primary">Tạo bài</button>
    </div>
  </form>
</dialog>

<dialog id="post-view-dialog" class="post-view-dialog">
  <div class="pv-head">
    <span id="pv-status" class="status-badge"></span>
    <button id="pv-close" class="pv-close-btn" aria-label="Đóng">&times;</button>
  </div>
  <h2 id="pv-title"></h2>
  <div id="pv-schedule" class="schedule-info"></div>
  <img id="pv-image" class="pv-image" style="display:none" alt="Ảnh bài viết" />
  <div id="pv-body" class="pv-body"></div>
  <div id="pv-metrics" class="pv-metrics" style="display:none"></div>
  <div class="pv-actions">
    <button id="pv-edit" class="btn btn-primary">Chỉnh sửa</button>
    <button id="pv-comments-btn" class="btn" style="display:none">Xem bình luận</button>
  </div>
  <div id="pv-comments-section" class="pv-comments-section" style="display:none">
    <h3>Bình luận trên Facebook</h3>
    <div id="pv-comments-list" class="pv-comments-list">Đang tải...</div>
    <div id="pv-reply-note" class="pv-reply-note"></div>
    <div class="pv-comment-box">
      <input type="text" id="pv-comment-input" placeholder="Trả lời với tư cách Page..." />
      <button id="pv-comment-send" class="btn btn-primary">Gửi</button>
    </div>
  </div>
</dialog>

<%- include('partials/footer') %>
